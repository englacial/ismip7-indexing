{
  "_comment": "The Lambda execution role, for an admin to create when the deployer may not create roles. Name it ismip7-virtualize-execution, then deploy with ExecutionRoleArn=<its ARN>. It reads only the credentials secret; source reads are anonymous and the store is written with the credentials from the secret.",
  "RoleName": "ismip7-virtualize-execution",
  "AssumeRolePolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Service": "lambda.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      }
    ]
  },
  "ManagedPolicyArns": [
    "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
  ],
  "InlinePolicy": {
    "PolicyName": "read-write-credentials-secret",
    "PolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "secretsmanager:GetSecretValue",
          "Resource": "arn:aws:secretsmanager:us-west-2:429435741471:secret:ismip7/sc_creds-*"
        }
      ]
    }
  }
}
